{
  "compilerOptions": {
    "target": "esnext",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "incremental": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vite/client", "jest"],
  },
  "include": ["**/*"],
  "exclude": [
    "node_modules",
    "pages/**",
    ".next/**",
    "dist/**",
    "dist-server/**",
    "dist-ipfs/**",
  ],
}
