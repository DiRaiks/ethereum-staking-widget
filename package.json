{
  "name": "lido-staking-widget",
  "version": "1.60.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently \"yarn dev:server\" \"yarn dev:client\"",
    "dev:server": "NODE_ENV=development tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:ipfs": "IPFS_MODE=true vite --config vite.ipfs.config.ts",
    "build": "yarn build:client && yarn build:server",
    "build:client": "vite build",
    "build:server": "node_modules/.bin/esbuild server/index.ts --bundle --platform=node --target=node20 --outfile=dist-server/server/index.js --format=esm --external:fsevents --packages=external --loader:.svg=empty --loader:.png=empty --loader:.jpg=empty",
    "build:ipfs": "IPFS_MODE=true vite build --config vite.ipfs.config.ts",
    "start": "NODE_ENV=production COLLECT_METRICS=true RUN_STARTUP_CHECKS=true node dist-server/server/index.js",
    "lint": "eslint --ext ts,tsx,js,mjs .",
    "lint:fix": "yarn lint --fix",
    "types": "tsc --noEmit",
    "postinstall": "husky install",
    "test": "yarn test:e2e",
    "test:unit": "jest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "concurrently": "^9.1.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "react-router-dom": "^7.1.5",
    "@base-org/account": "^2.5.1",
    "@coinbase/wallet-sdk": "^4.3.6",
    "@gemini-wallet/core": "~0.3.1",
    "@lidofinance/analytics-matomo": "^0.56.0",
    "@lidofinance/api-metrics": "^0.48.0",
    "@lidofinance/api-rpc": "^0.48.0",
    "@lidofinance/eth-api-providers": "^0.48.0",
    "@lidofinance/eth-providers": "^0.48.0",
    "@lidofinance/lido-ethereum-sdk": "4.6.0-alpha.4",
    "@lidofinance/lido-ui": "^3.36.0",
    "@lidofinance/rpc": "^0.48.0",
    "@lidofinance/satanizer": "^0.48.0",
    "@metamask/sdk": "~0.33.1",
    "@safe-global/safe-apps-provider": "~0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@tanstack/react-query": "^5.85.6",
    "@walletconnect/ethereum-provider": "^2.21.1",
    "copy-to-clipboard": "^3.3.1",
    "js-cookie": "^3.0.1",
    "lodash": "^4.17.21",
    "memory-cache": "^0.2.0",
    "ms": "^2.1.3",
    "next-secure-headers": "^2.2.0",
    "nprogress": "^0.2.0",
    "porto": "~0.2.35",
    "prom-client": "^14.0.1",
    "react": "^18.2.0",
    "react-device-detect": "^1.17.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.13",
    "react-hook-form": "^7.45.2",
    "react-is": "^18.2.0",
    "react-transition-group": "^4.4.2",
    "reef-knot": "8.0.0-alpha.1",
    "styled-components": "^5.3.5",
    "tiny-async-pool": "^1.2.0",
    "tiny-invariant": "^1.1.0",
    "uuid": "^8.3.2",
    "viem": "2.45.0",
    "wagmi": "3.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "vite": "^6.0.7",
    "vite-plugin-svgr": "^4.3.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@commitlint/prompt": "^20.3.1",
    "@lidofinance/eslint-config": "^0.34.0",
    "@playwright/test": "^1.49.1",
    "@types/jest": "28.1.6",
    "@types/js-cookie": "^3.0.0",
    "@types/lodash": "^4.14.186",
    "@types/memory-cache": "0.2.2",
    "@types/ms": "^0.7.31",
    "@types/node": "^18.6.1",
    "@types/nprogress": "^0.2.0",
    "@types/react": "^18.2.22",
    "@types/react-transition-group": "^4.4.3",
    "@types/styled-components": "^5.1.23",
    "@types/styled-system": "^5.1.17",
    "@types/uuid": "^8.3.2",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-sonarjs": "^0.20.0",
    "eslint-plugin-unicorn": "^48.0.1",
    "husky": "^7.0.1",
    "jest": "^29.5.0",
    "jsonschema": "^1.4.1",
    "lint-staged": "^13.2.3",
    "playwright": "^1.49.1",
    "prettier": "^3.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "5.7.3"
  },
  "lint-staged": {
    "./**/*.{ts,tsx}": [
      "eslint --ignore-path .gitignore --max-warnings=0"
    ],
    "./**/*.{ts,tsx,css,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1% and last 2 versions",
    "last 1 ios_saf major versions",
    "not dead",
    "not ie >= 0",
    "not op_mini all"
  ],
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
